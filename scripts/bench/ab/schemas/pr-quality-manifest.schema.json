{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pr-quality-manifest.schema.json",
  "title": "manifest.json of the pr-quality artifact (schema_version 1)",
  "description": "Identifies what the artifact was computed for. The workflow_run commenter never takes the PR number from here: it resolves the PR from the head SHA of the triggering run and uses this document only to check that both agree. sha256 and bytes are those of the two other files of the artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "pr_number", "head_sha", "base_sha", "merge_base_sha", "run_id", "run_attempt", "files", "verdict"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "lh-pr-quality"},
    "pr_number": {"type": "integer", "minimum": 1},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "merge_base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "run_id": {"type": "string", "pattern": "^[0-9]{1,20}$"},
    "run_attempt": {"type": "integer", "minimum": 1},
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quality.json", "pr-quality.md"],
      "properties": {
        "quality.json": {"$ref": "#/$defs/file"},
        "pr-quality.md": {"$ref": "#/$defs/file"}
      }
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failed", "gates"],
      "properties": {"failed": {"type": "boolean"}, "gates": {"type": "integer", "minimum": 0}}
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "bytes"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 5000000}
      }
    }
  }
}
