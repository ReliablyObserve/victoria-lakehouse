{
  "sides": [
    "base",
    "pr",
    "ref"
  ],
  "uids": {
    "vl": "vl-{side}",
    "loki": "loki-{side}",
    "jaeger": "jaeger-{side}"
  },
  "ranges": [
    "cold",
    "buffer"
  ],
  "tier": {
    "core": [
      "vl-explore-logs",
      "vl-builder-map-attr",
      "vl-stream-values",
      "vmui-logs",
      "jaeger-ui-services",
      "jaeger-ui-trace",
      "vl-explore-absent-sev",
      "vl-builder-severity",
      "vmui-severity-json"
    ]
  },
  "pages": [
    {
      "id": "vl-explore-logs",
      "kind": "vl-explore",
      "title": "Explore, VictoriaLogs datasource: logs and volume",
      "query": "*",
      "covers": [
        "vl.select.hits.basic"
      ]
    },
    {
      "id": "vl-builder-map-attr",
      "kind": "vl-builder",
      "title": "Explore query builder: values of a map attribute",
      "query": "*",
      "field": "http.method",
      "covers": [
        "vl.select.field_values.map_attr"
      ],
      "fixes": [
        "438-map"
      ],
      "clip": {
        "x": 520,
        "y": 110,
        "width": 780,
        "height": 480
      }
    },
    {
      "id": "vl-builder-absent",
      "kind": "vl-builder",
      "title": "Explore query builder: values of a field no row carries",
      "query": "*",
      "field": "component",
      "covers": [
        "vl.select.field_values.empty_absent_everywhere"
      ],
      "clip": {
        "x": 520,
        "y": 110,
        "width": 780,
        "height": 480
      }
    },
    {
      "id": "vl-stream-values",
      "kind": "vl-stream",
      "title": "Explore stream filters: values of a stream field",
      "query": "*",
      "field": "service.name",
      "covers": [
        "vl.select.stream_field_values.basic"
      ],
      "clip": {
        "x": 520,
        "y": 110,
        "width": 780,
        "height": 480
      }
    },
    {
      "id": "vl-stream-level",
      "kind": "vl-stream",
      "title": "Explore stream filters: values of level",
      "query": "*",
      "field": "level",
      "covers": [
        "vl.select.stream_field_values.basic"
      ],
      "clip": {
        "x": 520,
        "y": 110,
        "width": 780,
        "height": 480
      }
    },
    {
      "id": "vmui-logs",
      "kind": "vmui",
      "family": "logs",
      "title": "VMUI query",
      "query": "*",
      "covers": [
        "vl.select.hits.basic"
      ]
    },
    {
      "id": "vtui-traces",
      "kind": "vmui",
      "family": "traces",
      "title": "VTUI query",
      "query": "*",
      "covers": [
        "vt.select.logsql_hits.basic"
      ]
    },
    {
      "id": "vmui-sort-json",
      "kind": "vmui",
      "family": "logs",
      "title": "VMUI JSON view of * | sort | limit 20 (key order of each row)",
      "query": "* | sort | limit 20",
      "tab": "json",
      "covers": [
        "vl.select.logsql_query.wildcard"
      ]
    },
    {
      "id": "vtui-sort-json",
      "kind": "vmui",
      "family": "traces",
      "title": "VTUI JSON view of span_id:* | sort | limit 20 (key order of each row)",
      "query": "span_id:* | sort | limit 20",
      "tab": "json",
      "covers": [
        "vt.select.logsql_query.wildcard"
      ]
    },
    {
      "id": "jaeger-explore-search",
      "kind": "jaeger-explore",
      "title": "Explore, Jaeger datasource: service and operation lists",
      "covers": [
        "vt.jaeger.services.basic",
        "vt.jaeger.operations.basic"
      ]
    },
    {
      "id": "jaeger-explore-trace",
      "kind": "jaeger-explore",
      "trace": true,
      "title": "Explore, Jaeger datasource: trace view",
      "covers": [
        "vt.jaeger.traces_by_id.basic"
      ],
      "fixes": [
        "430-events-links"
      ]
    },
    {
      "id": "jaeger-ui-services",
      "kind": "jaeger-ui",
      "title": "Jaeger UI search: services and operations",
      "covers": [
        "vt.jaeger.services.basic",
        "vt.jaeger.operations.basic"
      ]
    },
    {
      "id": "jaeger-ui-trace",
      "kind": "jaeger-ui",
      "trace": true,
      "title": "Jaeger UI trace view",
      "covers": [
        "vt.jaeger.traces_by_id.basic"
      ],
      "fixes": [
        "430-events-links"
      ]
    },
    {
      "id": "loki-explore",
      "kind": "loki-explore",
      "title": "Explore, Loki via loki-vl-proxy",
      "query": "{service_name=~\".+\"}",
      "tier": "focused"
    },
    {
      "id": "dd-landing",
      "kind": "drilldown",
      "title": "Logs Drilldown: service landing",
      "path": "",
      "tier": "focused"
    },
    {
      "id": "dd-labels",
      "kind": "drilldown",
      "title": "Logs Drilldown: labels of a service",
      "path": "service/{service}/labels",
      "service": true,
      "tier": "focused"
    },
    {
      "id": "dd-label-values",
      "kind": "drilldown",
      "title": "Logs Drilldown: values of a label",
      "path": "service/{service}/label/{label}",
      "service": true,
      "tier": "focused",
      "target_panel": "{label}"
    },
    {
      "id": "dd-fields",
      "kind": "drilldown",
      "title": "Logs Drilldown: fields",
      "path": "service/{service}/fields",
      "service": true,
      "tier": "focused"
    },
    {
      "id": "dd-field-values",
      "kind": "drilldown",
      "title": "Logs Drilldown: values of a custom attribute with a dotted name (http.method)",
      "path": "service/{service}/field/{field}",
      "service": true,
      "tier": "focused",
      "target_panel": "{field}"
    },
    {
      "id": "dd-field-values-plain",
      "kind": "drilldown",
      "title": "Logs Drilldown: values of a custom attribute with a plain name (client_ip)",
      "path": "service/{service}/field/{plain_field}",
      "service": true,
      "tier": "focused",
      "target_panel": "{plain_field}"
    },
    {
      "id": "vl-explore-absent-sev",
      "kind": "vl-explore",
      "title": "Explore, VictoriaLogs datasource: rows written without severity_number (#274)",
      "query": "proofmark:=sev274",
      "covers": [
        "vl.select.query.absent_typed_field"
      ],
      "fixes": [
        "274-severity-number"
      ]
    },
    {
      "id": "vl-builder-severity",
      "kind": "vl-builder",
      "title": "Explore query builder: values of severity_number (#274)",
      "query": "proofmark:=sev274",
      "field": "severity_number",
      "covers": [
        "vl.select.field_values.absent_typed_field"
      ],
      "fixes": [
        "274-severity-number"
      ],
      "clip": {
        "x": 520,
        "y": 110,
        "width": 780,
        "height": 480
      }
    },
    {
      "id": "vmui-severity-json",
      "kind": "vmui",
      "family": "logs",
      "title": "VMUI JSON view of proofmark:=sev274 | sort by (_time) (the fields of each row, #274)",
      "query": "proofmark:=sev274 | sort by (_time)",
      "tab": "json",
      "covers": [
        "vl.select.query.absent_typed_field"
      ],
      "fixes": [
        "274-severity-number"
      ]
    }
  ],
  "vars": {
    "service": "api-gateway",
    "label": "k8s_namespace_name",
    "field": "http_method",
    "plain_field": "client_ip"
  }
}
