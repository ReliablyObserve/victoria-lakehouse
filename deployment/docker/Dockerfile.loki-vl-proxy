FROM alpine:3.21
# Pinned so a compose rebuild can't drift to a broken/older release.
# 1.56.1 fixed a `concurrent map read and map write` race in
# extractLogPatternsFromWindowEntriesWithStats that took
# loki-vl-proxy-cold down under Grafana log-volume histogram load
# (3+ concurrent windowed sub-queries) via snapshotEntriesForPatterns.
# 1.57.0 fixes high-cardinality Drilldown label/field panels (pod,
# *_id, trace_id/span_id) at 24h+: they previously returned ~142k
# uncapped single-point series at short ranges or an empty matrix at
# 24h+ (VictoriaLogs stats body exceeded the 16 MB cap), rendering as a
# single right-edge spike. Now detected_level filters use the
# column-indexed `level` field (~64x faster, no unpack_logfmt re-parse),
# single-field count() by(field) over >=2h routes to /select/logsql/hits
# for full-timeline series, and the 24h+ querySplitting residual-chunk
# spike is suppressed on every stats path. Also adds the L0 hot-key
# cache tier to metrics (tier="l0").
# 1.58.0 adds ring-wide cache purge: POST /admin/cache/flush?peers=1
# clears the local caches (L0+L1+L2) AND fans the purge out to every L3
# peer (X-Peer-Token auth, concurrent, 5s/peer; unreachable peers are
# reported, not fatal) via the new peer-side POST /_cache/purge — so an
# operator clears the whole fleet from one admin instance. Without
# ?peers the endpoint is local-only (unchanged). Used by all four
# loki-vl-proxy services (e2e hot+cold, benchmark lh + vl-lh).
#
# 1.58.0 -> 1.76.0. The releases in between are largely Loki-parity
# corrections on paths Grafana and Drilldown drive: invalid queries answer
# Loki's 400 bad_data instead of 502 (1.74.0); sliding range metrics and bare
# parser range metrics return the samples Loki returns, and query_range
# rejects (end-start)/step above 11,000 points (1.70.0, 1.73.0); `| json` /
# `| logfmt` parsed labels survive windowed and -stream-response log queries
# (1.72.0); /labels and /label/{name}/values return every name and value with
# data in the requested range, with versioned cache keys and a marker on
# answers served stale after a backend failure (1.71.0).
#
# Two of them change behaviour we do not depend on today, both verified
# against this repository before the bump:
#
#   - 1.75.0 makes a multi-tenant request fail as a whole when any tenant
#     fails, as Loki does, and removes the X-Multi-Tenant-Partial-Failures
#     header and the partial `warnings`. Nothing here reads that header or
#     relies on a partial answer.
#   - 1.76.0 reports /loki/api/v1/index/volume and /index/volume_range in
#     BYTES (Loki v3.7 semantics, via VictoriaLogs sum_len(_msg)) rather than
#     line counts, and restamps the buckets to Loki's convention. No
#     dashboard, alert, test or script here reads those endpoints, so there is
#     nothing to adjust — but anything added later that graphs volume must be
#     written against bytes.
ARG VERSION=1.76.0
ARG TARGETARCH=amd64
RUN wget -qO /usr/local/bin/loki-vl-proxy \
      "https://github.com/ReliablyObserve/loki-vl-proxy/releases/download/v${VERSION}/loki-vl-proxy-linux-${TARGETARCH}" \
    && chmod +x /usr/local/bin/loki-vl-proxy
ENTRYPOINT ["/usr/local/bin/loki-vl-proxy"]
