FROM golang:1.27.3-alpine3.23@sha256:5d5113301ffcac84e2bfb20c42648803fecaea6789c89bb9b66884e18cbb30a7 AS builder
RUN apk add --no-cache git
WORKDIR /app
# Must equal the Makefile's VL_VERSION_LOGS (asserted by
# TestDockerfilePinsMatchMakefile in tests/conformance).
ARG VL_VERSION=v1.53.0
COPY go.mod go.sum ./
RUN mkdir -p deps && \
    git clone --depth 1 --branch ${VL_VERSION} https://github.com/VictoriaMetrics/VictoriaLogs.git deps/VictoriaLogs && \
    go mod download
COPY . .
RUN CGO_ENABLED=0 GOWORK=off go build -o /datagen ./cmd/datagen

FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
COPY --from=builder /datagen /usr/local/bin/datagen
USER nonroot
ENTRYPOINT ["/usr/local/bin/datagen"]
