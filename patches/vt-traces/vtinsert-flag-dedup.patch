diff --git a/app/vtinsert/insertutil/flags.go b/app/vtinsert/insertutil/flags.go
index a7ddff0..07b3ecc 100644
--- a/app/vtinsert/insertutil/flags.go
+++ b/app/vtinsert/insertutil/flags.go
@@ -1,15 +1,22 @@
 package insertutil
 
 import (
-	"flag"
+	vlinsertutil "github.com/VictoriaMetrics/VictoriaLogs/app/vlinsert/insertutil"
 )
 
+// MaxFieldsPerLine and DefaultMsgValue ARE VictoriaLogs' flags in the
+// lakehouse-traces binary, which links both vlinsert/insertutil and this
+// package: the same -insert.maxFieldsPerLine and -defaultMsgValue command-line
+// flags exist once, and an operator's value reaches VictoriaTraces' ingest code
+// too. They alias VictoriaLogs' pointers instead of registering a second flag
+// (a duplicate registration panics at startup) or copying the value at init
+// (which runs before flag.Parse, so a copy would keep the default forever).
+// Importing the VictoriaLogs package makes it initialize first, whatever the
+// package paths sort like. Added by patches/vt-traces/vtinsert-flag-dedup.patch.
 var (
-	// MaxFieldsPerLine is the maximum number of fields per line for /insert/* handlers
-	MaxFieldsPerLine = flag.Int("insert.maxFieldsPerLine", 1000, "The maximum number of log fields per line, which can be read by /insert/* handlers; "+
-		"see https://docs.victoriametrics.com/victorialogs/faq/#how-many-fields-a-single-log-entry-may-contain")
+	// MaxFieldsPerLine is the maximum number of fields per line for /insert/* handlers.
+	MaxFieldsPerLine = vlinsertutil.MaxFieldsPerLine
 
 	// DefaultMsgValue is the default value for _msg field if the ingested log entry doesn't contain it.
-	DefaultMsgValue = flag.String("defaultMsgValue", "-",
-		"Default value for _msg field; see https://docs.victoriametrics.com/victorialogs/keyconcepts/#message-field")
+	DefaultMsgValue = vlinsertutil.DefaultMsgValue
 )
