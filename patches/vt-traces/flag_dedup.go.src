func safeArrayString(name, description string) *flagutil.ArrayString {
	if f := flag.Lookup(name); f != nil {
		if v, ok := f.Value.(*flagutil.ArrayString); ok {
			return v
		}
		return &flagutil.ArrayString{}
	}
	return flagutil.NewArrayString(name, description)
}

// upstream-original: a flag.Lookup guard in front of flagutil.NewArrayBool. No
// upstream body is copied; which collisions must be guarded is checked
// against both vendored trees by TestVTFlagDedupCoversEveryCollision.
func safeArrayBool(name, description string) *flagutil.ArrayBool {
	if f := flag.Lookup(name); f != nil {
		if v, ok := f.Value.(*flagutil.ArrayBool); ok {
			return v
		}
		return &flagutil.ArrayBool{}
	}
	return flagutil.NewArrayBool(name, description)
}

// sharedScalar returns a pointer to the scalar the existing flag f stores, when
// f is one of the standard library's scalar flags (flag.Int, flag.Bool,
// flag.String, flag.Duration): their Value types are unexported named types
// whose underlying type is the scalar itself (`type intValue int`), so the
// pointer the flag package keeps is a valid *T. It returns nil for any other
// value, or when the type name does not match.
//
// upstream-original: reads the value pointer the standard library flag package
// keeps for a flag some other package registered; no upstream body is copied.
func sharedScalar[T any](f *flag.Flag, stdType string) *T {
	if reflect.TypeOf(f.Value).String() != stdType {
		return nil
	}
	rv := reflect.ValueOf(f.Value)
	if rv.Kind() != reflect.Pointer || rv.Type().Elem().Size() != unsafe.Sizeof(*new(T)) {
		return nil
	}
	return (*T)(rv.UnsafePointer())
}

// upstream-original: a flag.Lookup guard in front of flag.Int. No
// upstream body is copied; which collisions must be guarded is checked
// against both vendored trees by TestVTFlagDedupCoversEveryCollision.
func safeInt(name string, value int, usage string) *int {
	if f := flag.Lookup(name); f != nil {
		if p := sharedScalar[int](f, "*flag.intValue"); p != nil {
			return p
		}
		v := value
		return &v
	}
	return flag.Int(name, value, usage)
}

