// upstream-original: a flag.Lookup guard in front of flag.Duration. No
// upstream body is copied; which collisions must be guarded is checked
// against both vendored trees by TestVTFlagDedupCoversEveryCollision.
func safeDuration(name string, value time.Duration, usage string) *time.Duration {
	if f := flag.Lookup(name); f != nil {
		if p := sharedScalar[time.Duration](f, "*flag.durationValue"); p != nil {
			return p
		}
		v := value
		return &v
	}
	return flag.Duration(name, value, usage)
}
