package vtstorage

import (
	"flag"
	"reflect"
	"time"
	"unsafe"

	"github.com/VictoriaMetrics/VictoriaMetrics/lib/flagutil"

	// The lakehouse-traces binary links VictoriaLogs' vlstorage, which registers
	// the same flag names as this package. Importing it here makes it initialize
	// FIRST (a package initializes after the packages it imports), so the
	// flag.Lookup guards below see VictoriaLogs' registration whatever the
	// import paths sort like, and a registration on this side can never win the
	// race and make VictoriaLogs' own registration panic.
	_ "github.com/VictoriaMetrics/VictoriaLogs/app/vlstorage"
)

// Safe flag registration helpers that skip registration when the flag already
// exists. Prevents panics when both VL's vlstorage and VT's vtstorage are in
// the same binary.
//
// When the flag already exists, the helper hands back VictoriaLogs' own value,
// not a detached copy: the command-line setting (and a password read from a
// file or URL) is then the one both packages see. A detached copy would read
// the default instead, e.g. an auth key that reads empty and lets every request
// through. Only when the existing registration is of an unexpected type does a
// detached default come back.

// upstream-original: a flag.Lookup guard in front of flagutil.NewRetentionDuration. No
// upstream body is copied; which collisions must be guarded is checked
// against both vendored trees by TestVTFlagDedupCoversEveryCollision.
func safeRetentionDuration(name, defaultValue, description string) *flagutil.RetentionDuration {
	if f := flag.Lookup(name); f != nil {
		if v, ok := f.Value.(*flagutil.RetentionDuration); ok {
			return v
		}
		d := &flagutil.RetentionDuration{}
		_ = d.Set(defaultValue)
		return d
	}
	return flagutil.NewRetentionDuration(name, defaultValue, description)
}

// upstream-original: a flag.Lookup guard in front of flagutil.NewBytes. No
// upstream body is copied; which collisions must be guarded is checked
// against both vendored trees by TestVTFlagDedupCoversEveryCollision.
func safeBytes(name string, defaultValue int64, description string) *flagutil.Bytes {
	if f := flag.Lookup(name); f != nil {
		if v, ok := f.Value.(*flagutil.Bytes); ok {
			return v
		}
		return &flagutil.Bytes{N: defaultValue}
	}
	return flagutil.NewBytes(name, defaultValue, description)
}

// upstream-original: a flag.Lookup guard in front of flagutil.NewPassword. No
// upstream body is copied; which collisions must be guarded is checked
// against both vendored trees by TestVTFlagDedupCoversEveryCollision.
func safePassword(name, description string) *flagutil.Password {
	if f := flag.Lookup(name); f != nil {
		if v, ok := f.Value.(*flagutil.Password); ok {
			return v
		}
		// A zero Password has no value stored and its Get() dereferences nil;
		// Set("") stores the empty default, so the detached copy is usable.
		p := &flagutil.Password{}
		_ = p.Set("")
		return p
	}
	return flagutil.NewPassword(name, description)
}

