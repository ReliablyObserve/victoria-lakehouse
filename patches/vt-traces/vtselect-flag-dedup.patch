+// allowPartialResponseFlagValue returns the current -search.allowPartialResponse value.
+//
+// lakehouse-traces links VL's vlselect/logsql, which already registers
+// -search.allowPartialResponse; registering it here too panics at init with
+// "flag redefined" (which of the two runs first is not something to rely on).
+// So this copy never registers the flag: it reads the value VL's registration
+// holds, at call time, so the command-line setting reaches the Tempo and
+// Jaeger handlers. Added by patches/vt-traces/vtselect-flag-dedup.patch.
+func allowPartialResponseFlagValue() bool {
+	f := flag.Lookup("search.allowPartialResponse")
+	if f == nil {
+		return false
+	}
+	v, _ := strconv.ParseBool(f.Value.String())
+	return v
+}
+
+// registerAllowPartialResponseFlag is upstream's own registration, kept here
+// only so the flag's definition (name, default, help text) stays in the
+// vendored tree that the conformance inventory and the config-surface checks
+// read. Nothing calls it in lakehouse-traces: VL's vlselect/logsql registers the
+// flag, and a second registration panics at init.
+func registerAllowPartialResponseFlag() *bool {
+	return flag.Bool("search.allowPartialResponse", false, "Whether to allow returning partial responses when some of vtstorage nodes "+
+		"from the -storageNode list are unavailable for querying. This flag works only for cluster setup of VictoriaTraces. "+
+		"See https://docs.victoriametrics.com/victoriatraces/querying/#partial-responses")
+}
 
