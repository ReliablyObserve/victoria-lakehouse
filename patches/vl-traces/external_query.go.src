package logstorage

import (
	"fmt"

	"github.com/VictoriaMetrics/VictoriaLogs/lib/prefixfilter"
)

// RunQueryExternal executes a query with full pipe processing for external
// storage backends. The searchFn provides raw filtered rows; pipes from
// qctx.Query are then applied to produce the final output.
//
// This reuses VL's native runPipes machinery — no reimplementation needed.
//
// NOTE: this entry point does NOT preprocess subqueries embedded inside
// pipes (join/in/union). For queries that may contain such subqueries —
// notably VT's servicegraph background task — use
// RunQueryExternalWithSubqueries instead, passing the adapter's own
// RunQuery as the runQuery callback so the inner side of a `| join …`
// can be resolved against the same external backend.
//
// upstream-copy: lib/logstorage/storage_search.go (*Storage).runQuery
// upstream-divergence: this is upstream's runQuery with the local tier's
// searchParallel replaced by searchFn, and WITHOUT the initSubqueries call
// upstream makes first. A query carrying `in(...)`, `join`, `union` or
// `stream_context` therefore reaches runPipes with its subqueries
// unresolved. That is why nothing in Lakehouse calls this entry point —
// both adapters call RunQueryExternalWithSubqueries — and why it stays
// exported only as the documented no-subquery form. Upstream's own
// per-tier options (getSearchOptions, GetParallelReaders,
// defaultParallelReaders) have no meaning for an external backend and are
// deliberately dropped; concurrency and the pipe chain are reused verbatim.
func RunQueryExternal(qctx *QueryContext, searchFn func(writeBlock WriteDataBlockFunc) error, writeBlock WriteDataBlockFunc) error {
	writeBlockResult := writeBlock.newBlockResultWriter()

	q := qctx.Query
	concurrency := q.GetConcurrency()

	search := func(stopCh <-chan struct{}, writeBlockToPipes writeBlockResultFunc) error {
		wb := writeBlockToPipes.newDataBlockWriter()
		return searchFn(wb)
	}

	return runPipes(qctx, q.pipes, search, writeBlockResult, concurrency)
}

// ExternalRunQueryFn mirrors the external storage adapter's RunQuery
// signature so RunQueryExternalWithSubqueries can recursively dispatch
// inner subqueries through the same backend. The adapter typically
// satisfies this by passing its own RunQuery method.
type ExternalRunQueryFn func(qctx *QueryContext, writeBlock WriteDataBlockFunc) error

// RunQueryExternalWithSubqueries behaves like RunQueryExternal but
// additionally preprocesses subqueries embedded in pipes (currently:
// `| join …`) before running the main pipe pipeline. The supplied
// runQuery callback is invoked for each inner subquery — adapters
// typically pass their own RunQuery here.
//
// This mirrors the native path in storage_search.go where the local
// storage runs initJoinMaps(...) before runPipes(...). Without this
// preprocessing, the join pipe processor finds an empty lookup map
// and silently returns zero matched rows.
//
// Background: VictoriaTraces' servicegraph background task issues a
// `… | join by (span_id) (…) inner | …` query. On the native hot tier
// `storage_search.go` resolves both sides through the same `runQuery`.
// The external storage adapter must do the same — otherwise the inner
// subquery never executes and the cold tier serves an empty
// Service Graph.
//
// upstream-copy: lib/logstorage/storage_search.go initSubqueries
// upstream-divergence: upstream's initSubqueries runs FOUR initialisers —
// initFilterInValues (`in(...)` subqueries), initJoinMaps (`join`),
// initUnionQueries (`union`) and initStreamContextPipes (`stream_context`).
// This function runs only initJoinMaps, because that is the one Lakehouse
// has a cold-tier test for; the other three are resolved on the hot tier
// only, so a cold query using them returns fewer rows than the same query
// against upstream rather than failing. Reuse-first note: the remaining
// three cannot simply be called here — initUnionQueries and
// initStreamContextPipes take a runQueryFunc over writeBlockResultFunc and
// a *QueryContext they re-parent, so adopting them is an adapter change,
// not a one-line call. Tracked as a cold-tier parity gap. The tail after
// the initialisers is upstream (*Storage).runQuery's, baselined separately
// under RunQueryExternal.
func RunQueryExternalWithSubqueries(qctx *QueryContext, searchFn func(writeBlock WriteDataBlockFunc) error, runQuery ExternalRunQueryFn, writeBlock WriteDataBlockFunc) error {
	q := qctx.Query

	// Adapt the adapter's WriteDataBlockFunc-shaped RunQuery into the
	// writeBlockResultFunc-shaped runQueryFunc used by getRows. Each
	// inner subquery reuses the SAME backend, so joins can nest.
	runQueryInternal := runQueryFunc(func(qctxLocal *QueryContext, writeBlock writeBlockResultFunc) error {
		wb := writeBlock.newDataBlockWriter()
		return runQuery(qctxLocal, wb)
	})

	getJoinRows := func(qInner *Query) ([][]Field, error) {
		qctxLocal := qctx.WithQuery(qInner)
		return getRows(qctxLocal, runQueryInternal)
	}

	qNew, err := initJoinMaps(q, getJoinRows)
	if err != nil {
		return fmt.Errorf("cannot initialize `join` subqueries: %w", err)
	}

	qctxNew := qctx.WithQuery(qNew)
	writeBlockResult := writeBlock.newBlockResultWriter()
	concurrency := qNew.GetConcurrency()

	search := func(stopCh <-chan struct{}, writeBlockToPipes writeBlockResultFunc) error {
		wb := writeBlockToPipes.newDataBlockWriter()
		return searchFn(wb)
	}

	return runPipes(qctxNew, qNew.pipes, search, writeBlockResult, concurrency)
}

// QueryHasPipes returns true if the query has pipe operators attached.
//
// upstream-original: an accessor for the unexported Query.pipes field, which
// upstream exposes no getter for. No upstream logic is duplicated; a rename
// of the field breaks the build loudly.
func QueryHasPipes(q *Query) bool {
	return len(q.pipes) > 0
}

// QueryNeedsAllFields returns true when the query contains a pipe that
// enumerates every field on the input rows rather than projecting a
// known subset. The external storage backend must bypass column-
// narrowing for such queries — otherwise the projection would hand the
// pipe a DataBlock with only the columns its byFields/fieldFilters
// list mentions, and field enumeration would see an artificially
// truncated schema.
//
// Currently recognises VL's `field_names`, `field_values`, `facets`,
// and `block_stats` pipes — the ones VT's Tempo handlers use for tag
// enumeration (`/api/v2/search/tags`), tag value enumeration
// (`/api/v2/search/tag/<k>/values`), and compare metrics
// (`/api/metrics/query_range` with `compare(...)`).
//
// upstream-typeset: pipes-implementing-updateNeededFields
// upstream-divergence: the switch enumerates four of upstream's pipe types by
// hand. Upstream has no marker for "this pipe enumerates every field", so a
// pipe added upstream falls through into the projected-subset branch — right
// for most pipes, wrong for any new field-enumerating one, and silent either
// way because it neither fails to compile nor errors at query time. The
// baselined type set makes an upstream pipe addition fail this guard, so the
// new pipe is classified by a human instead of defaulted.
func QueryNeedsAllFields(q *Query) bool {
	if q == nil {
		return false
	}
	for _, p := range q.pipes {
		switch p.(type) {
		case *pipeFieldNames, *pipeFieldValues, *pipeFacets, *pipeBlockStats:
			return true
		}
	}
	return false
}

// CloneWithoutPipes returns a shallow copy of q with pipes removed.
// Use this when passing a query to a storage backend that should return
// raw filtered data — pipe processing happens externally via RunQueryExternal.
//
// upstream-original: a struct copy with pipes cleared. Upstream's own
// Query.Clone renders the query to text and parses it back, which is both
// lossy and panics on queries VictoriaLogs accepts but cannot print (see
// QueryFilter); there is no upstream function that does this.
func CloneWithoutPipes(q *Query) *Query {
	qCopy := *q
	qCopy.pipes = nil
	return &qCopy
}

// QueryFilter returns the filter of q for row-level evaluation (MatchRow)
// without rendering q to text and parsing it back. That round trip fails for
// queries VL accepts but cannot print back in parseable form (for example
// `>'-'`) — Query.Clone turns the failure into a panic, which the
// VictoriaMetrics HTTP server answers by exiting the process — and a re-parse
// anchors relative time filters (`_time:5m`) to the parse time instead of the
// query's timestamp. Returns nil when q is nil or has no filter.
//
// upstream-original: an accessor for the unexported Query.f field wrapped in
// the exported Filter type upstream already declares. No upstream logic is
// duplicated.
func QueryFilter(q *Query) *Filter {
	if q == nil || q.f == nil {
		return nil
	}
	return &Filter{f: q.f}
}

// GetQueryPipeFields returns field names referenced by pipe operators.
// Walks both `by(...)` / `fields` clauses *and* the column arguments of
// stats aggregation functions (`histogram(duration)`, `sum(x)`,
// `quantile(0.9, y)`, `count(z)`, …). Uses VL's parsed pipe types
// directly — no string re-parsing needed.
//
// Stats funcs declare their input columns through
// `statsFunc.updateNeededFields(*prefixfilter.Filter)`; this routine asks
// each func what it needs and collects the allow-list. Without this,
// projections that only see `byFields` would skip the aggregation
// argument column entirely — e.g. a Tempo metrics query
// `{...} | stats by(_time:1h) histogram(duration)` would project
// `_time` but drop `duration`, and the histogram would compute over an
// empty column. See lakehouse cold-tier parity (PR #105) for the
// failure mode this prevents.
//
// upstream-copy: lib/logstorage/parser.go getNeededColumns
// upstream-divergence: upstream's getNeededColumns is the complete answer —
// it walks the pipe chain BACKWARDS and asks EVERY pipe, through the
// pipe.updateNeededFields interface method, which input fields it needs.
// This function walks FORWARDS and asks only four pipe types by hand
// (pipeStats, pipeUniq, pipeTop, pipeFields), so every other pipe —
// extract, unpack_json, math, format, filter, sort, replace, unroll, and
// each one upstream adds — contributes nothing and its input columns are
// projected away. That is cold-tier parity divergence B4. It is NOT
// replaced by a call to getNeededColumns in this bump: getNeededColumns
// returns a *prefixfilter.Filter seeded with allow-`*` and answers in
// prefix patterns, while the Parquet projection needs exact column names
// and treats "cannot resolve precisely" as "read every column" — swapping
// them changes which columns every cold query reads, which is a read-path
// and performance change that must be measured, not folded into an
// upstream bump. Reuse-first target: replace this function with
// getNeededColumns plus a prefix-to-column resolution step.
func GetQueryPipeFields(q *Query) []string {
	if q == nil {
		return nil
	}
	var fields []string
	seen := make(map[string]bool)
	add := func(name string) {
		if name != "" && !seen[name] {
			seen[name] = true
			fields = append(fields, name)
		}
	}
	addFromStatsFunc := func(f statsFunc) {
		if f == nil {
			return
		}
		var pf prefixfilter.Filter
		f.updateNeededFields(&pf)
		for _, name := range pf.GetAllowFilters() {
			// updateNeededFields may emit prefix patterns (e.g. "k8s.*"); the
			// projection layer expects exact field names, so drop wildcards —
			// the projection will fall back to "read all columns" naturally
			// when an essential field can't be precisely resolved.
			if name == "" || name[len(name)-1] == '*' {
				continue
			}
			add(name)
		}
	}
	for _, p := range q.pipes {
		switch t := p.(type) {
		case *pipeStats:
			for _, bf := range t.byFields {
				add(bf.name)
			}
			for i := range t.funcs {
				addFromStatsFunc(t.funcs[i].f)
			}
		case *pipeUniq:
			for _, name := range t.byFields {
				add(name)
			}
		case *pipeTop:
			for _, name := range t.byFields {
				add(name)
			}
		case *pipeFields:
			for _, name := range t.fieldFilters {
				add(name)
			}
		}
	}
	return fields
}

// TimeBucket describes one `_time` bucketing applied by a `stats by (_time:<step>)`
// pipe — the shape every LogsQL histogram query takes (`/select/logsql/hits`
// builds `stats by (_time:step) count()`, `stats_query_range` the same).
//
// SizeStr and OffsetStr keep VL's original string forms because calendar
// buckets ("week", "month", "year") truncate differently from a plain
// nanosecond duration; TruncateTimestampToBucket feeds them straight back
// into VL's own truncation routine.
type TimeBucket struct {
	SizeStr   string
	Size      int64
	OffsetStr string
	Offset    int64
}

// GetQueryTimeBucketing classifies how the query consumes the rows handed to
// it, so an external storage backend can decide whether it may answer from
// metadata alone instead of reading per-row values.
//
// It returns the `_time` buckets the query groups by, and needsRowValues=true
// when the answer depends on anything a metadata-only block cannot reproduce.
// The rule is deliberately strict — a backend serving rows it never read must
// be able to prove the answer is identical to a scan:
//
//   - The FIRST pipe must be a `stats` pipe. Rows reaching a pipe ahead of it
//     are still raw, and a pipe there can read, reorder or drop them by value
//     (`| sort by (_time) | limit 1 | stats count()` keeps a different row
//     depending on whether the timestamps are real). Note that probing such a
//     pipe with updateNeededFields cannot detect this: pipes short-circuit
//     when the caller needs no field, so `sort` reports needing nothing.
//   - That `stats` pipe may group only by `_time`, and only with a bucket:
//     `by (_time)` ungrouped makes every distinct row timestamp its own group.
//   - Its aggregate functions may need no field (`count()` — not `count(x)`,
//     not `sum(x)`), and may not carry a per-function `if (...)` filter.
//   - Pipes AFTER the `stats` pipe see group keys and aggregates, never raw
//     rows, so they are unconstrained (`hits` appends `sort by (_time)` there).
//   - A query with no `stats` pipe returns the rows themselves: their values
//     must be real.
//
// upstream-original: upstream has no "can this query be answered without
// reading row values" predicate; this is LH's own, written against upstream's
// unexported `*pipeStats` (byFields/hasBucketConfig, funcs with `iff` and
// updateNeededFields). It reads that struct rather than copying a function, so
// the drift guard cannot baseline it and an upstream change here fails neither
// the build nor a query — it would silently classify a query metadata-only
// while the new construct needs real rows. Re-read pipeStats on every VL bump;
// the conservative default (return needsRowValues=true) is what every early
// return above takes, so an unrecognised shape costs a scan, never a wrong
// answer.
func GetQueryTimeBucketing(q *Query) (buckets []TimeBucket, needsRowValues bool) {
	if q == nil || len(q.pipes) == 0 {
		return nil, true
	}
	ps, ok := q.pipes[0].(*pipeStats)
	if !ok {
		return nil, true
	}
	for _, bf := range ps.byFields {
		if bf.name != "_time" || !bf.hasBucketConfig() {
			return nil, true
		}
		buckets = append(buckets, TimeBucket{
			SizeStr:   bf.bucketSizeStr,
			Size:      int64(bf.bucketSize),
			OffsetStr: bf.bucketOffsetStr,
			Offset:    int64(bf.bucketOffset),
		})
	}
	for i := range ps.funcs {
		f := &ps.funcs[i]
		if f.f == nil || f.iff != nil {
			return nil, true
		}
		var pf prefixfilter.Filter
		f.f.updateNeededFields(&pf)
		if !pf.MatchNothing() {
			return nil, true
		}
	}
	return buckets, false
}

// TruncateTimestampToBucket returns the start of the bucket ts falls into,
// using VL's own truncation so calendar buckets, week alignment and bucket
// offsets behave exactly as they do inside `stats by (_time:...)`.
//
// upstream-original: an exported wrapper with no upstream counterpart. The
// truncation itself is upstream's own truncateTimestamp, called unchanged, so
// calendar buckets, week alignment and offsets stay identical to what
// `stats by (_time:...)` computes — LH only needs it reachable from outside
// the package. It carries no logic to drift.
func TruncateTimestampToBucket(ts int64, b TimeBucket) int64 {
	size := b.Size
	if size <= 0 {
		size = 1
	}
	return truncateTimestamp(ts, size, b.Offset, b.SizeStr)
}
