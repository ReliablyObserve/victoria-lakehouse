      "title": "Rewrite Durability & Deferrals",
      "description": "A rewrite deletes nothing until the tombstone record authorising it is durable. Sustained deferrals mean deletes have stopped progressing (no data is at risk); unfinished rewrites must reach 0 before a rollback.",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(lakehouse_delete_tombstone_not_durable_total{instance=~\"$instance\"}[5m])",
          "legendFormat": "record not durable/s"
