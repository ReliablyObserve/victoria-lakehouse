        {
          "expr": "sum by (source) (rate(lakehouse_catalog_value_lookups_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "requests {{source}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 109 },
      "id": 88,
      "title": "Write Durability",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 110 },
      "id": 87,
      "title": "Failed Drains, Refused Inserts, Pending Segments",
      "description": "Buffer drains that stopped on an error and resume with the same bytes (flush errors); buffer-flusher errors by stage (collect, intent, head, upload, marker, commit, mark, invariant; near 0, invariant must stay 0); rows a drain skipped because their object's key was already compacted, rewritten or removed (near 0); inserts refused with 429 because the buffer volume is below its free-space floor (reason read_only); rows the insert path dropped when they were added, for a _time before 1970 or a stream over the tenant's cardinality limit (the request is still answered as a success), and rows the drain left out of a segment; whether a segment is stalled because its rows do not match the drain's plan (0/1); the age of the oldest segment waiting to be written, and the number of segments waiting. An object-store outage refuses nothing: the segments wait on disk.",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(lakehouse_insert_flush_errors_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "failed drains/s"
        },
        {
          "expr": "sum(rate(lakehouse_insert_rows_superseded_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "rows skipped, object retired/s"
        },
        {
          "expr": "sum by (stage) (rate(lakehouse_buffer_flush_errors_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "buffer flusher errors/s {{stage}}"
        },
        {
          "expr": "sum by (reason) (rate(lakehouse_insert_rejected_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "inserts refused/s {{reason}}"
        },
        {
          "expr": "sum by (reason) (rate(lakehouse_insert_rows_dropped_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "rows dropped at insert/s {{reason}}"
        },
        {
          "expr": "sum by (reason) (rate(lakehouse_buffer_flush_rows_dropped_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "rows dropped at drain/s {{reason}}"
        },
        {
          "expr": "max(lakehouse_buffer_stalled_segments{instance=~\"$instance\"})",
          "legendFormat": "stalled segment (0/1)"
        },
        {
          "expr": "max(lakehouse_buffer_oldest_pending_age_seconds{instance=~\"$instance\"})",
          "legendFormat": "oldest pending segment (s)"
        },
        {
          "expr": "sum(lakehouse_buffer_segments{instance=~\"$instance\",state=\"pending\"})",
          "legendFormat": "segments waiting"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 118 },
      "id": 90,
      "title": "Compaction Forward Fence",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } } },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 119 },
      "id": 91,
      "title": "Objects Left Alone Because They Hold Unknown Columns",
      "description": "Objects that compaction (op=compact) or the delete rewriter (op=delete_rewrite) refused to rewrite because they hold a column this version does not know: a rewrite would drop that column. Counted once per object per process. Near 0 on a single-version fleet; an increase means a newer version is writing objects this one cannot rewrite, so finish the rollout. The alert is LakehouseCompactionSkippedUnknownColumns.",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (signal, op) (increase(lakehouse_compaction_skipped_unknown_columns_total{instance=~\"$instance\"}[1h]))",
          "legendFormat": "objects skipped (1h) {{signal}} {{op}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 127 },
      "id": 92,
      "title": "Ring Membership",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "max": 1, "custom": { "drawStyle": "line", "fillOpacity": 10 } } },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 128 },
      "id": 93,
      "title": "Does Each Pod Find Itself In The Ring",
      "description": "1 when the pod found exactly one entry for itself in the discovered member list of the ring (compaction ownership, peer cache), by its IP, its StatefulSet hostname, a dashed-IP name or a DNS answer on its listen port. 0 means none or several match: the pod owns nothing in that ring (no compaction, no orphan sweep) or fetches its own cache keys from its peers. in_peers is 1 only when that entry is also in the set the ring hashes over (not draining). Set POD_IP / POD_IPS or check the headless service. A peercache 0 is normal for a pod that is not behind the peer headless service. The alert is LakehouseRingSelfUnresolved (compaction ring only).",
      "type": "timeseries",
      "targets": [
        {
          "expr": "lakehouse_ring_self_resolved{instance=~\"$instance\"}",
          "legendFormat": "resolved {{instance}} {{ring}}"
        },
        {
          "expr": "lakehouse_ring_self_in_peers{instance=~\"$instance\"}",
          "legendFormat": "in peers {{instance}} {{ring}}"
        }
      ]
    }
