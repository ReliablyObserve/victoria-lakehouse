      "title": "Bounded Bookkeeping",
      "description": "Every cross-restart memory here is bounded, and dropping an entry has a cost: a forgotten retired key is served again.",
      "type": "timeseries",
      "targets": [
        {
          "expr": "lakehouse_manifest_retired_delete_owed{instance=~\"$instance\"}",
