      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "WAL Size",
      "type": "stat",
      "targets": [{ "expr": "lakehouse_insert_wal_bytes{instance=~\"$instance\"}", "legendFormat": "" }]
